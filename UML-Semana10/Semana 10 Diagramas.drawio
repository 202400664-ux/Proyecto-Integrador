        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_CU05_AsignarGateway\nactor \&quot;:MotorAsignacionEDA0\&quot; as EDA\nparticipant \&quot;:GaritaUI\&quot; as UI\nparticipant \&quot;:ControladorDescarga\&quot; as CTRL\nparticipant \&quot;:Pedido\&quot; as P\nparticipant \&quot;:Gateway\&quot; as GW\n\nEDA -&gt; CTRL : solicitarAsignacion(codPedido)\nactivate CTRL\n\nCTRL -&gt; P : esCargaConstruccion()\nactivate P\nP --&gt; CTRL : boolean (esConstruccion)\ndeactivate P\n\nalt [Carga de Construcción (Requisito RN-08)]\n    CTRL -&gt; GW : consultarDisponibilidad() [Gateway 5]\n    activate GW\n    GW --&gt; CTRL : boolean (disponible)\n    deactivate GW\n\n    alt [Gateway 5 Disponible]\n        CTRL -&gt; GW : asignarBahia(codPedido)\n        activate GW\n        GW --&gt; CTRL : confirmacionBahia\n        deactivate GW\n\n        CTRL -&gt; P : actualizarEstado(EN_DESCARGA)\n        activate P\n        P --&gt; CTRL : 200 OK\n        deactivate P\n\n        CTRL --&gt; UI : 200 OK (Bahía 5 Asignada)\n\n    else [Gateway 5 Ocupado]\n        CTRL -&gt; EDA : aplicarAgingEnCola()\n        CTRL --&gt; UI : Estado \&quot;En Cola por Prioridad\&quot;\n    end\n\nelse [Carga General (Gateways 1 a 4)]\n    CTRL -&gt; GW : consultarDisponibilidad() [Gateways 1..4]\n    activate GW\n    GW --&gt; CTRL : boolean (disponible)\n    deactivate GW\n\n    alt [Bahía Compatible Libre]\n        CTRL -&gt; GW : asignarBahia(codPedido)\n        activate GW\n        GW --&gt; CTRL : confirmacionBahia\n        deactivate GW\n\n        CTRL -&gt; P : actualizarEstado(EN_DESCARGA)\n        activate P\n        P --&gt; CTRL : 200 OK\n        deactivate P\n\n        CTRL --&gt; UI : 200 OK (Bahía Asignada)\n\n    else [Bahías Compatibles Ocupadas]\n        CTRL -&gt; EDA : aplicarAgingEnCola()\n        CTRL --&gt; UI : Estado \&quot;En Cola con Incremento de Aging\&quot;\n    end\nend\n\ndeactivate CTRL\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Big4dD3Jo6Y3uJOmLc0D-295">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
