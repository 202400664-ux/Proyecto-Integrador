        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Diagrama_Clases_SumaControl_v2\nskinparam classAttributeIconSize 0\nskinparam style strictuml\n\nabstract class Usuario {\n  - idUsuario: String [PK]\n  - nombreCompleto: String\n  - email: String\n  - hashPassword: String\n  - rolUsuario: EnumRol\n  + autenticar(passwordIngresada: String): Boolean\n  + recuperarPassword(): Void\n  + obtenerRol(): EnumRol\n}\n\nclass OperadorGarita {\n  - idOperador: String\n  - turnoTrabajo: String\n  - codigoGaritaAsignada: String\n  + capturarLlegada(idCita: String, placa: String): Void\n  + consultarCitasProgramadas(): List~CitaLogistica~\n}\n\nclass Proveedor {\n  - rucProveedor: String [PK]\n  - razonSocial: String\n  - telefonoContacto: String\n  - emailContacto: String\n  - nivelRiesgo: EnumRiesgo\n  + actualizarDatosContacto(email: String, tel: String): Void\n  + esProveedorRiesgo(): Boolean\n}\n\nclass Pedido {\n  - codPedido: String [PK]\n  - rucProveedor: String [FK]\n  - tipoCarga: EnumTipoCarga\n  - volumenM3: Double\n  - pesoKg: Double\n  - estadoPedido: EnumEstadoPedido\n  + esCargaConstruccion(): Boolean\n  + obtenerDetalleCarga(): String\n  + actualizarEstado(nuevoEstado: EnumEstadoPedido): Void\n}\n\nclass CitaLogistica {\n  - idCita: String [PK]\n  - codPedido: String [FK]\n  - fechaHoraProgramada: Date\n  - ventanaToleranciaMin: Integer = 15\n  - estadoCita: EnumEstadoCita\n  + reprogramarCita(nuevaFecha: Date, motivo: String): Boolean\n  + estaEnTolerancia(horaLlegadaReal: Date): Boolean\n  + marcarComoAusente(): Void\n}\n\nclass RegistroGarita {\n  - idRegistro: String [PK]\n  - idCita: String [FK]\n  - placaVehiculo: String\n  - nombreConductor: String\n  - timestampLlegadaReal: Date\n  - clasificacionPuntualidad: EnumPuntualidad\n  + registrarLlegadaReal(placa: String, timestamp: Date): Void\n  + calcularClasificacion(toleranciaMin: Integer): EnumPuntualidad\n  + solicitarAsignacionGateway(): Void\n}\n\nclass Gateway {\n  - idGateway: Integer [PK]\n  - nombreBahia: String\n  - estadoGateway: EnumEstadoGateway\n  - esExclusivoConstruccion: Boolean\n  + ocuparBahia(codPedido: String): Boolean\n  + liberarBahia(): Void\n  + consultarDisponibilidad(): Boolean\n}\n\nclass MotorAsignacionEDA0 {\n  - algoritmoPrioridad: String = \&quot;MinHeap_Aging\&quot;\n  - colaEsperaActiva: PriorityQueue~RegistroGarita~\n  - tiempoMaximoEsperaMin: Integer = 60\n  + evaluarPrioridad(registro: RegistroGarita): Integer\n  + asignarGatewayExclusivo(pedido: Pedido): Gateway\n  + verificarCompatibilidad(pedido: Pedido, gateway: Gateway): Boolean\n  + aplicarAgingEnCola(): Void\n}\n\n&#39; Relaciones UML con Multiplicidad y Roles Limpios\nUsuario &lt;|-- OperadorGarita\n\nProveedor \&quot;1\&quot; -- \&quot;0..*\&quot; Pedido : realiza &gt;\nOperadorGarita \&quot;1\&quot; -- \&quot;0..*\&quot; RegistroGarita : registra &gt;\nPedido \&quot;1\&quot; -- \&quot;1\&quot; CitaLogistica : programa &gt;\n\nCitaLogistica \&quot;1\&quot; *-- \&quot;0..1\&quot; RegistroGarita : genera &gt;\nRegistroGarita \&quot;0..*\&quot; o-- \&quot;0..5\&quot; Gateway : asigna &gt;\n\nMotorAsignacionEDA0 ..&gt; Pedido : verifica &gt;\nMotorAsignacionEDA0 ..&gt; RegistroGarita : evalua &gt;\nMotorAsignacionEDA0 ..&gt; Gateway : orquesta &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Big4dD3Jo6Y3uJOmLc0D-347">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
